    "config": {
        "files": "{\"server.properties\":{\"parser\":\"properties\",\"find\":{\"server-port\":\"{{server.build.default.port}}\"}}}",
        "startup": "{\"done\":\")! For help, type \"}",
        "logs": "{}",

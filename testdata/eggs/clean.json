            "script": "#!/bin/bash\nset -euo pipefail\ncd /mnt/server\ncurl -fsSL -o \"${SERVER_JARFILE}\" \"https://example.com/server.jar\"\nif [ ! -s \"${SERVER_JARFILE}\" ]; then\n  echo \"download failed\"\n  exit 1\nfi\n",
            "container": "ghcr.io/pterodactyl/installers:debian",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "Server Jar File",
            "description": "The name of the server jarfile to run the server with.",
            "env_variable": "SERVER_JARFILE",
            "default_value": "server.jar",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|regex:/^([\\w\\d._-]+)(\\.jar)$/",
            "field_type": "text"
